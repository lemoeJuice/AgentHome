# Set AGENT_HOME_USE_PROXY=1 to pass the configured proxy variables into the
# Agent Home container. Leave it at 0 when direct container networking works.
AGENT_HOME_USE_PROXY=0

# These values override the host's matching HTTP_PROXY/HTTPS_PROXY/ALL_PROXY/
# NO_PROXY variables when proxy mode is enabled. The endpoint must be reachable
# from the Podman network, not only from the host loopback interface.
# AGENT_HOME_HTTP_PROXY=http://host.containers.internal:7890
# AGENT_HOME_HTTPS_PROXY=http://host.containers.internal:7890
# AGENT_HOME_ALL_PROXY=
# AGENT_HOME_NO_PROXY=localhost,127.0.0.1,.local
