# Copy to a deployment-only .env file. Never commit real credentials.
AGENT_HOME_CONFIG=./config/agent-home.json
SNOWLUMA_ACCESS_TOKEN=
PI_COMMAND=pi
PI_PROVIDER=
PI_MODEL=
AGENT_HOME_LOG_LEVEL=info
# Required when GATEWAY_MCP_HOST is not loopback. Keep the action allowlist explicit.
GATEWAY_MCP_HOST=127.0.0.1
GATEWAY_MCP_PORT=8787
GATEWAY_MCP_TOKEN=
GATEWAY_MCP_WORKER_TOKEN=
GATEWAY_MCP_WORKER_TASK_ID=
GATEWAY_MCP_ALLOWED_ACTIONS=
